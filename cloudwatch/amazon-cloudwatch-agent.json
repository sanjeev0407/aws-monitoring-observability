{
 "agent":{"metrics_collection_interval":60},
 "metrics":{"namespace":"Demo/Host","append_dimensions":{"InstanceId":"${aws:InstanceId}"},"metrics_collected":{
  "cpu":{"measurement":["cpu_usage_idle","cpu_usage_user","cpu_usage_system"],"totalcpu":true},
  "mem":{"measurement":["mem_used_percent"]},
  "disk":{"measurement":["used_percent"],"resources":["/"]}
 }},
 "logs":{"logs_collected":{"files":{"collect_list":[
  {"file_path":"/var/log/myapp/application.log","log_group_name":"/demo/application","log_stream_name":"{instance_id}/application","timezone":"UTC"}
 ]}}}
}
